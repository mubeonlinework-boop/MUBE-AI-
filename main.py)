def check_daily_limit(user_id, kind):
    today = datetime.now().strftime("%Y-%m-%d")
    rec = daily_usage[user_id]
    if rec["date"] != today:
        rec["date"] = today
        rec["image"] = 0
        rec["voice"] = 0
    limit = MAX_IMAGE_PER_USER_DAY if kind == "image" else MAX_VOICE_PER_USER_DAY
    if rec[kind] >= limit and user_id != OWNER_ID:
        return False
    rec[kind] += 1
    return True


